# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Gemini API
GEMINI_API_KEY=AIzaSy...

# ZenQuotes (public API — no key required)
ZENQUOTES_BASE_URL=https://zenquotes.io/api

# Firebase — shared across Android & iOS
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Firebase Android
FIREBASE_ANDROID_API_KEY=AIzaSy...
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxxxxxx

# Firebase iOS
FIREBASE_IOS_API_KEY=AIzaSy...
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxx
FIREBASE_IOS_BUNDLE_ID=com.example.yourapp
